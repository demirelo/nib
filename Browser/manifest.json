{
  "manifest_version": 3,
  "name": "Nib",
  "version": "0.2.3",
  "description": "Private, on-device writing suggestions as you type.",
  "homepage_url": "https://github.com/demirelo/nib",
  "minimum_chrome_version": "114",
  "host_permissions": ["http://*/*", "https://*/*"],
  "permissions": [
    "storage",
    "nativeMessaging", "scripting"],
  "action": {
    "default_title": "Nib",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/nib-16.png",
      "32": "icons/nib-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/nib-16.png",
    "32": "icons/nib-32.png",
    "48": "icons/nib-48.png",
    "128": "icons/nib-128.png"
  },
  "key": "",
  "background": {
    "service_worker": "background.js"
  }
}
